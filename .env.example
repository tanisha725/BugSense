# Copy this file to .env and change values if needed.
# Never commit the real .env file.

# Address of the React app (the backend allows requests from it)
FRONTEND_URL=http://localhost:5173

# Address of the FastAPI backend (the React app calls it)
VITE_API_URL=http://localhost:8000

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Postgres.app needs no user or password on your own Mac.
DATABASE_URL=postgresql+psycopg://localhost:5432/bugsense

# AI diagnosis (optional). Without a key the rule-based investigator is used.
# A free key: https://console.groq.com  Any OpenAI-compatible provider works.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Login. SECRET_KEY signs the sign-in tokens: set a long random value in
# production (without it, everyone must sign in again after a restart).
SECRET_KEY=
# true = anyone may create an account (the first account can always be made)
ALLOW_SIGNUP=false

# OpenTelemetry senders must send this as "Authorization: Bearer <token>".
# Empty = anyone may send (fine on your own computer).
INGEST_TOKEN=
