# Copy this file to .env and change values if needed.
# Never commit the real .env file.

# Address of the React app (the backend allows requests from it)
FRONTEND_URL=http://localhost:5173

# Address of the FastAPI backend (the React app calls it)
VITE_API_URL=http://localhost:8000

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Postgres.app needs no user or password on your own Mac.
DATABASE_URL=postgresql+psycopg://localhost:5432/bugsense
